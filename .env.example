# ==============================================================================
# PRIVACY & SECURITY WARNING
# ==============================================================================
# 1. NEVER commit your actual .env file to version control (Git).
# 2. This file (.env.example) serves strictly as a template. Do NOT place real
#    secret API keys, passwords, or tokens in this file.
# 3. Always ensure .env is listed in your .gitignore file.
# 4. Server-side keys (like RESEND_API_KEY) must never be prefixed with
#    NEXT_PUBLIC_, as doing so would expose them to the public browser client.
# ==============================================================================

# ------------------------------------------------------------------------------
# Email Handling (Resend API)
# ------------------------------------------------------------------------------
# Used securely in server-side API routes (app/api/contact/route.ts) to send
# contact form messages. Keep this key strictly confidential.
RESEND_API_KEY="re_your_secure_resend_api_key_placeholder"

# ------------------------------------------------------------------------------
# Canonical Site Configuration
# ------------------------------------------------------------------------------
# Safe to expose publicly if required. Used for canonical URLs and metadata.
# Defaults to http://localhost:3000 in local development environments.
NEXT_PUBLIC_SITE_URL="https://0x-subrat.vercel.app"
